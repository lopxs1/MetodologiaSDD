# Configurações de desenvolvimento local - Backend (Spring Boot 3 + PostgreSQL 18)
# NUNCA insira senhas reais, tokens de produção ou dados confidenciais neste arquivo.
# Ao configurar seu ambiente, copie este arquivo para .env (ignorado pelo Git).

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Conexão PostgreSQL 18 (Schema amde_digital)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amde_digital
DB_SCHEMA=amde_digital

# Role da aplicação (apenas DML - usada pelo Spring Data JPA / HikariCP)
DB_APP_USER=amde_digital_app
DB_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# Role dona do schema (apenas DDL - usada exclusivamente pelo Liquibase)
DB_OWNER_USER=amde_digital_owner
DB_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD

# URLs e propriedades Spring Boot 3 / Hibernate 6 / Liquibase
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/amde_digital?currentSchema=amde_digital
SPRING_DATASOURCE_USERNAME=amde_digital_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_APP_PASSWORD
SPRING_JPA_PROPERTIES_HIBERNATE_DEFAULT_SCHEMA=amde_digital
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

SPRING_LIQUIBASE_ENABLED=true
SPRING_LIQUIBASE_CHANGE_LOG=classpath:db/changelog/db.changelog-master.yaml
SPRING_LIQUIBASE_USER=amde_digital_owner
SPRING_LIQUIBASE_PASSWORD=CHANGE_ME_OWNER_PASSWORD
SPRING_LIQUIBASE_DEFAULT_SCHEMA=amde_digital
SPRING_LIQUIBASE_LIQUIBASE_SCHEMA=amde_digital

# Segurança JWT (chave fictícia somente para testes locais)
JWT_SECRET=chave-ficticia-local-com-no-minimo-256-bits-para-desenvolvimento-sdd
JWT_EXPIRATION_MS=86400000

# Armazenamento local de prontuários PDF
UPLOAD_DIR=uploads/prontuarios
