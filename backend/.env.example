# Configurações de desenvolvimento local - Backend (Exemplo ilustrativo)
# NUNCA insira senhas reais, tokens de produção ou dados confidenciais neste arquivo.
# Ao configurar seu ambiente, copie este arquivo para .env (que é ignorado pelo git).

PORT=8000
HOST=0.0.0.0
ENVIRONMENT=developmen

# Conexão com banco de dados local (exemplo ilustrativo)
DATABASE_URL=postgresql://usuario_dev:senha_dev@localhost:5432/banco_dev

# Chave secreta para geração de tokens locais (valor fictício de desenvolvimento)
SECRET_KEY=chave-ficticia-somente-para-testes-locais-123456789

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG
