{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": {
      "primary": { "$value": "#1A5276", "$type": "color", "$description": "Azul institucional da AMDE para cabeçalhos e botões principais" },
      "primary-hover": { "$value": "#154360", "$type": "color" },
      "secondary": { "$value": "#0284C7", "$type": "color", "$description": "Azul claro de destaque e links" },
      "accent": { "$value": "#0EA5E9", "$type": "color" }
    },
    "status": {
      "success": { "$value": "#16A34A", "$type": "color", "$description": "Status Concluído ou Presença Confirmada" },
      "success-bg": { "$value": "#DCFCE7", "$type": "color" },
      "warning": { "$value": "#D97706", "$type": "color", "$description": "Status Retorno ou Alerta" },
      "warning-bg": { "$value": "#FEF3C7", "$type": "color" },
      "danger": { "$value": "#DC2626", "$type": "color", "$description": "Status Cancelado ou Ação Destrutiva" },
      "danger-bg": { "$value": "#FEE2E2", "$type": "color" },
      "info": { "$value": "#2563EB", "$type": "color", "$description": "Status Agendado" },
      "info-bg": { "$value": "#DBEAFE", "$type": "color" }
    },
    "role": {
      "admin-badge": { "$value": "#DC2626", "$type": "color" },
      "medico-badge": { "$value": "#2563EB", "$type": "color" },
      "paciente-badge": { "$value": "#16A34A", "$type": "color" }
    },
    "neutral": {
      "background": { "$value": "#F8FAFC", "$type": "color", "$description": "Fundo da aplicação" },
      "surface": { "$value": "#FFFFFF", "$type": "color", "$description": "Superfície de cards e modais" },
      "border": { "$value": "#E2E8F0", "$type": "color" },
      "text-primary": { "$value": "#0F172A", "$type": "color" },
      "text-secondary": { "$value": "#64748B", "$type": "color" },
      "text-muted": { "$value": "#94A3B8", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "heading": { "$value": "Inter, -apple-system, sans-serif", "$type": "fontFamily" },
      "body": { "$value": "Inter, -apple-system, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "JetBrains Mono, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
